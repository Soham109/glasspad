{
  "name": "glasspad-promo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "voice:list": "node scripts/vo-list.ts",
    "voice:samples": "node scripts/vo-samples.ts",
    "voice": "node scripts/make-voice.ts",
    "music:try": "node scripts/music-try.ts",
    "mix": "esbuild scripts/mix.ts --bundle --platform=node --format=esm --outfile=voice/work/mix.mjs --log-level=warning && node voice/work/mix.mjs",
    "verify": "esbuild scripts/verify-sync.ts --bundle --platform=node --format=esm --outfile=voice/work/verify-sync.mjs --log-level=warning && node voice/work/verify-sync.mjs",
    "stills": "node scripts/stills.mjs",
    "render": "remotion render src/index.ts GlasspadDemo out/glasspad-demo.mp4 && scripts/remux.sh out/glasspad-demo.mp4 public/mix-film-vo.wav",
    "render:novo": "scripts/remux-copy.sh out/glasspad-demo.mp4 public/mix-film-novo.wav out/glasspad-demo-no-vo.mp4",
    "render:teaser": "remotion render src/index.ts GlasspadTeaser out/glasspad-teaser-vertical.mp4 && scripts/remux.sh out/glasspad-teaser-vertical.mp4 public/mix-teaser.wav",
    "render:all": "pnpm voice && pnpm mix && pnpm verify && pnpm render && pnpm render:novo && pnpm render:teaser",
    "typecheck": "tsc -p .",
    "v4:cues": "esbuild scripts/v4/cues.ts --bundle --platform=node --format=esm --outfile=voice/work/v4-cues.mjs --log-level=warning && node voice/work/v4-cues.mjs",
    "render:v4": "scripts/v4/render.sh",
    "render:4k": "scripts/v4/render-4k.sh",
    "v4:verify": "python3 -I scripts/v4/verify.py",
    "motion:cues": "esbuild scripts/motion/cues.ts --bundle --platform=node --format=esm --outfile=voice/work/motion-cues.mjs --log-level=warning --external:react --external:remotion && node voice/work/motion-cues.mjs",
    "motion:voice": "python3 -I scripts/motion/voice.py",
    "motion:mix": "python3 -I scripts/motion/mix.py",
    "render:motion": "scripts/motion/render.sh",
    "render:motion-4k": "scripts/motion/render-4k.sh",
    "thumbs:motion": "node scripts/motion/thumbs.mjs --4k"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/fonts": "4.0.535",
    "@remotion/motion-blur": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
