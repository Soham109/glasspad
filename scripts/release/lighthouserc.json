{
  "ci": {
    "collect": {
      "startServerCommand": "npm --prefix web run preview -- --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/install",
        "http://localhost:4173/guide",
        "http://localhost:4173/use/iphone-as-mac-trackpad",
        "http://localhost:4173/compare/universal-control"
      ],
      "numberOfRuns": 3,
      "settings": { "chromeFlags": "--no-sandbox --headless=new" }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.98 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 350000 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 100000 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 60000 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
