# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.{swift,py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Generated or exact-content files: leave as they are.
[{*.xcassets/**,promo/src/**/*.json,web/public/*.txt}]
insert_final_newline = unset
trim_trailing_whitespace = unset
